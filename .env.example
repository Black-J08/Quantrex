# Quantrex DhanHQ Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# DhanHQ API Access Token (JWT)
# Get this from https://dhanhq.co/ -> My Profile -> API Access
# The token is a JWT (HS512). The framework extracts dhanClientId from the
# JWT automatically, so you can leave DHAN_CLIENT_ID blank in most cases.
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# DhanHQ Client ID (e.g. "1112625384")
# Optional when DHAN_ACCESS_TOKEN is set: it is read from the JWT's
# dhanClientId claim. Set it explicitly here if your token does not carry
# the claim or you want to override the extracted value.
# DHAN_CLIENT_ID=your_dhan_client_id_here

# Optional: Use sandbox environment for testing
# DHAN_BASE_URL=https://sandbox.dhan.co

# Quantrex Zerodha Kite Connect Configuration
# Get API credentials from https://developers.kite.trade/
# The redirect URL must be registered in Kite Developer Console for your API key
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here

# Zerodha Kite Connect Callback Configuration
# Single source of truth for callback - must match the redirect URL registered in Kite Developer Console
# Format: http://host:port/path (e.g., http://localhost:8765/callback)
ZERODHA_REDIRECT_URL=http://localhost:8765/callback

# Optional: Timeout for waiting for callback (seconds)
# ZERODHA_CALLBACK_TIMEOUT=120
